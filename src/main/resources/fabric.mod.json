{
  "schemaVersion": 1,
  "id": "cobblesync",
  "version": "${version}",
  "name": "CobbleSync",
  "description": "Real Time Web Dashboard companion showing Pokédex progress per-player.",
  "authors": ["Beubeu"],
  "contact": {
    "sources": "https://github.com/BeubeuReturns/cobblesync",
    "issues": "https://github.com/BeubeuReturns/cobblesync/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/cobblesync/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.cobblesync.CobbleSync"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.cobblesync.client.CobbleSyncClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": "*",
    "cobblemon": ">=1.7.3 <1.8.0",
    "minecraft": "${mc_version}",
    "java": ">=${java_version}"
  }
}
